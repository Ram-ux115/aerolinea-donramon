<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Reserva de vuelos - Aerolíneas Don Ramón">
    <title>Reservar Vuelo - Aerolíneas Don Ramón</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            /* Paleta de colores consistente con index.html */
            --bg-color: #dde0f0;
            --text-color: #333333;
            --card-bg: #ffffff; /* Un blanco más limpio para los formularios */
            --navbar-bg: #1f2022;
            --navbar-text: #ccced0;
            --hero-bg: linear-gradient(135deg, #2b2d42, #4a4e69);
            --primary-color: #6c63ff;
            --secondary-color: #ff6600;
            --section-line: #ff6600;
            --shadow-color: rgba(0,0,0,0.1);
            --light-color: #f8f9fa;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: var(--text-color);
            background-color: var(--bg-color);
        }

        .navbar {
            background-color: var(--navbar-bg) !important;
        }

        .navbar .nav-link {
            color: var(--navbar-text) !important;
        }

        .navbar .nav-link:hover, .navbar .nav-link.active {
            color: var(--primary-color) !important;
        }

        .section-title {
            position: relative;
            padding-bottom: 10px;
            margin-bottom: 1.5rem;
            color: var(--text-color);
        }

        .section-title:after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 50px;
            height: 3px;
            background: var(--section-line);
        }
        
        .main-card {
            background-color: var(--card-bg);
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 20px var(--shadow-color);
        }

        .flight-list-item {
            transition: background-color 0.3s;
        }

        .flight-list-item:hover {
            background-color: #f0f4ff;
        }

        /* Estilos para el calendario */
        .calendar {
            background: #fff;
            border-radius: 10px;
            padding: 1.5rem;
            box-shadow: 0 5px 15px var(--shadow-color);
        }
        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        .calendar-body {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }
        .calendar-day {
            text-align: center;
            padding: 0.75rem 0.5rem;
            cursor: pointer;
            border-radius: 50%;
            transition: background-color 0.3s, color 0.3s;
        }
        .calendar-day.weekday {
            font-weight: bold;
            cursor: default;
        }
        .calendar-day:not(.weekday):hover {
            background-color: var(--primary-color);
            color: white;
        }
        .calendar-day.selected {
             background-color: var(--secondary-color);
             color: white;
        }
        .calendar-day.empty {
            cursor: default;
        }
        .availability-info {
            background-color: #e9edff;
            border-left: 5px solid var(--primary-color);
            padding: 1rem;
            margin-top: 1.5rem;
            border-radius: 5px;
        }
    </style>
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1f2022;">
    <div class="container">
        <a class="navbar-brand" href="../index.html">
            <span style="font-weight: bold; font-size: 1.3rem;">AEROLÍNEAS DON RAMÓN</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="../index.html">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="nosotros.html">Más de Nosotros</a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link active" href="reservas.html">Reservar Vuelo</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="iniciosesion.html">Iniciar Sesión</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container my-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="main-card h-100">
                <h2 class="section-title">Buscar Vuelos Próximos</h2>
                <div class="mb-4">
                    <label for="paisOrigen" class="form-label fw-bold">Selecciona un estado de origen:</label>
                    <select class="form-select" id="paisOrigen">
                        <option value="ags" selected>Aguascalientes</option>
                        <option value="bc">Baja California</option>
                        <option value="bcs">Baja California Sur</option>
                        <option value="camp">Campeche</option>
                        <option value="chis">Chiapas</option>
                        <option value="chih">Chihuahua</option>
                        <option value="cdmx">Ciudad de México</option>
                        <option value="coah">Coahuila</option>
                        <option value="col">Colima</option>
                        <option value="dgo">Durango</option>
                        <option value="gto">Guanajuato</option>
                        <option value="gro">Guerrero</option>
                        <option value="hgo">Hidalgo</option>
                        <option value="jal">Jalisco</option>
                        <option value="edomex">Estado de México</option>
                        <option value="mich">Michoacán</option>
                        <option value="mor">Morelos</option>
                        <option value="nay">Nayarit</option>
                        <option value="nl">Nuevo León</option>
                        <option value="oax">Oaxaca</option>
                        <option value="pue">Puebla</option>
                        <option value="qro">Querétaro</option>
                        <option value="qroo">Quintana Roo</option>
                        <option value="slp">San Luis Potosí</option>
                        <option value="sin">Sinaloa</option>
                        <option value="son">Sonora</option>
                        <option value="tab">Tabasco</option>
                        <option value="tamps">Tamaulipas</option>
                        <option value="tlax">Tlaxcala</option>
                        <option value="ver">Veracruz</option>
                        <option value="yuc">Yucatán</option>
                        <option value="zac">Zacatecas</option>
                    </select>
                </div>

                <h3 class="h5 mb-3">Vuelos Disponibles</h3>
                <div id="listaVuelos" class="list-group">
                    </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="main-card h-100">
                 <h2 class="section-title">Calendario de Disponibilidad</h2>
                 <div class="calendar">
                     <div class="calendar-header">
                         <h4 id="month-year">Octubre 2025</h4>
                     </div>
                     <div class="calendar-body">
                         <div class="calendar-day weekday">D</div>
                         <div class="calendar-day weekday">L</div>
                         <div class="calendar-day weekday">M</div>
                         <div class="calendar-day weekday">M</div>
                         <div class="calendar-day weekday">J</div>
                         <div class="calendar-day weekday">V</div>
                         <div class="calendar-day weekday">S</div>
                     </div>
                     <div id="calendar-days" class="calendar-body">
                         </div>
                 </div>
                 <div id="vuelosDisponibles" class="availability-info mt-4">
                     <p class="mb-0">Selecciona una fecha para ver la disponibilidad de vuelos.</p>
                 </div>
            </div>
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const paisSelect = document.getElementById('paisOrigen');
        const listaVuelos = document.getElementById('listaVuelos');
        const calendarDaysContainer = document.getElementById('calendar-days');
        const vuelosDisponiblesInfo = document.getElementById('vuelosDisponibles');

        const vuelosPorPais = {
          'ags': ['Ciudad de México', 'Los Angeles', 'Houston', 'Cancún', 'Monterrey'],
          'bc': ['San Diego', 'Tijuana', 'Guadalajara', 'Las Vegas', 'Phoenix'],
          'bcs': ['Cabo San Lucas', 'Dallas', 'Vancouver', 'Ciudad de México', 'Denver'],
          'camp': ['Mérida', 'Ciudad de México', 'Villahermosa', 'Houston', 'Miami'],
          'chis': ['Tuxtla Gutiérrez', 'Oaxaca', 'Ciudad de México', 'Cancún', 'Guatemala City'],
          'chih': ['Ciudad Juárez', 'Monterrey', 'El Paso', 'Denver', 'Ciudad de México'],
          'cdmx': ['Nueva York', 'París', 'Tokio', 'Madrid', 'São Paulo', 'Bogotá'],
          'coah': ['Saltillo', 'Monterrey', 'San Antonio', 'Dallas', 'Torreón'],
          'col': ['Manzanillo', 'Guadalajara', 'Puerto Vallarta', 'Ciudad de México', 'Los Angeles'],
          'dgo': ['Mazatlán', 'Ciudad de México', 'Monterrey', 'Chicago', 'Tijuana'],
          'gto': ['León', 'Houston', 'Chicago', 'Ciudad de México', 'Cancún'],
          'gro': ['Acapulco', 'Ciudad de México', 'Toluca', 'Montreal', 'Zihuatanejo'],
          'hgo': ['Pachuca', 'Cancún', 'Querétaro', 'Veracruz', 'Monterrey'],
          'jal': ['Puerto Vallarta', 'Chicago', 'Los Angeles', 'Ciudad de México', 'Toronto'],
          'edomex': ['Cancún', 'Monterrey', 'Tijuana', 'Houston', 'Guadalajara'],
          'mich': ['Morelia', 'Chicago', 'Oakland', 'Ciudad de México', 'Tijuana'],
          'mor': ['Cuernavaca', 'Tijuana', 'Monterrey', 'Guadalajara', 'Cancún'],
          'nay': ['Tepic', 'Puerto Vallarta', 'Tijuana', 'Ciudad de México', 'Guadalajara'],
          'nl': ['Houston', 'Las Vegas', 'Ciudad de México', 'Madrid', 'San Antonio'],
          'oax': ['Puerto Escondido', 'Huatulco', 'Dallas', 'Ciudad de México', 'Los Angeles'],
          'pue': ['Houston', 'Cancún', 'Monterrey', 'Guadalajara', 'Tijuana'],
          'qro': ['Dallas', 'Chicago', 'Houston', 'Ciudad de México', 'Cancún'],
          'qroo': ['Miami', 'Bogotá', 'Londres', 'Nueva York', 'Toronto'],
          'slp': ['Dallas', 'Houston', 'Ciudad de México', 'Cancún', 'Tijuana'],
          'sin': ['Culiacán', 'Mazatlán', 'Phoenix', 'Tijuana', 'Guadalajara'],
          'son': ['Hermosillo', 'Phoenix', 'Tucson', 'Guadalajara', 'Ciudad de México'],
          'tab': ['Villahermosa', 'Ciudad de México', 'Mérida', 'Cancún', 'Houston'],
          'tamps': ['Tampico', 'Reynosa', 'Houston', 'Veracruz', 'Ciudad de México'],
          'tlax': ['Cancún', 'Monterrey', 'Houston', 'Puebla', 'Guadalajara'],
          'ver': ['Houston', 'Monterrey', 'Mérida', 'Ciudad de México', 'Guadalajara'],
          'yuc': ['Mérida', 'Miami', 'Houston', 'Toronto', 'La Habana'],
          'zac': ['Chicago', 'Los Angeles', 'Dallas', 'Tijuana', 'Ciudad de México']
        };

        // --- LÓGICA DE VUELOS PRÓXIMOS (IZQUIERDA) ---
        function generarVuelosAleatorios(pais) {
            listaVuelos.innerHTML = '<div class="text-center p-3"><div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Loading...</span></div> Actualizando...</div>';
            
            setTimeout(() => {
                listaVuelos.innerHTML = '';
                const destinos = vuelosPorPais[pais];
                if (!destinos) return;

                const numeroVuelos = 4 + Math.floor(Math.random() * 2); // Entre 4 y 5 vuelos

                for (let i = 0; i < numeroVuelos; i++) {
                    const destino = destinos[Math.floor(Math.random() * destinos.length)];
                    const hora = String(Math.floor(Math.random() * 18) + 6).padStart(2, '0'); // Horas entre 06 y 23
                    const minutos = String(Math.floor(Math.random() * 60)).padStart(2, '0');
                    
                    const vueloHTML = `
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flight-list-item">
                            <div>
                                <h5 class="mb-1">${destino}</h5>
                                <small>Salida: ${hora}:${minutos} hrs</small>
                            </div>
                            <button class="btn btn-sm btn-outline-primary">Seleccionar</button>
                        </a>`;
                    listaVuelos.insertAdjacentHTML('beforeend', vueloHTML);
                }
            }, 300); // Pequeño delay para simular carga
        }

        paisSelect.addEventListener('change', () => {
            generarVuelosAleatorios(paisSelect.value);
        });
        
        // Carga inicial
        generarVuelosAleatorios('ags');

        // --- LÓGICA DEL CALENDARIO (DERECHA) ---
        const hoy = new Date(2025, 9, 2); // Fijado a la fecha actual del contexto: 2 de Octubre 2025
        const mes = hoy.getMonth();
        const anio = hoy.getUTCFullYear();
        
        function generarCalendario(mes, anio) {
            calendarDaysContainer.innerHTML = '';
            const primerDia = new Date(anio, mes, 1).getDay();
            const diasEnMes = new Date(anio, mes + 1, 0).getDate();

            // Espacios vacíos al inicio del mes
            for (let i = 0; i < primerDia; i++) {
                calendarDaysContainer.innerHTML += '<div class="calendar-day empty"></div>';
            }

            // Días del mes
            for (let dia = 1; dia <= diasEnMes; dia++) {
                const dayElement = document.createElement('div');
                dayElement.classList.add('calendar-day');
                dayElement.textContent = dia;
                dayElement.dataset.date = `${anio}-${String(mes + 1).padStart(2, '0')}-${String(dia).padStart(2, '0')}`;
                dayElement.addEventListener('click', () => mostrarDisponibilidad(dia, dayElement));
                calendarDaysContainer.appendChild(dayElement);
            }
        }

        function mostrarDisponibilidad(dia, element) {
            // Desmarcar día previously seleccionado
            const selected = document.querySelector('.calendar-day.selected');
            if (selected) {
                selected.classList.remove('selected');
            }
            // Marcar nuevo día
            element.classList.add('selected');

            // Simular disponibilidad
            const vuelosSimulados = Math.floor(Math.random() * 5); // 0 a 4 vuelos
            if (vuelosSimulados > 0) {
                 vuelosDisponiblesInfo.innerHTML = `<p class="fw-bold mb-1">Hay ${vuelosSimulados} vuelos disponibles para el ${dia} de Octubre.</p><small>Horarios: 08:30, 12:00, 18:45...</small>`;
            } else {
                 vuelosDisponiblesInfo.innerHTML = `<p class="fw-bold mb-0">No hay vuelos disponibles para el ${dia} de Octubre.</p>`;
            }
        }
        
        generarCalendario(mes, anio);
    });
</script>

</body>
</html>
